                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const data = pm.response.json();\r",
                  "const savedId = pm.collectionVariables.get(\"postId\");\r",
                  "\r",
                  "pm.test(\"El ID coincide con la variable consultada\", function () {\r",
                  "    pm.expect(data.id).to.eql(parseInt(savedId));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"El post contiene datos de usuario\", function () {\r",
                  "    pm.expect(data).to.have.property(\"userId\");\r",
                  "});"
                ]
              }
            }
