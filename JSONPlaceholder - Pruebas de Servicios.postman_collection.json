        {
          "name": "Crear Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Post creado exitosamente (201)\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const data = pm.response.json();\r",
                  "pm.test(\"El post tiene un ID asignado\", function () {\r",
                  "    pm.expect(data).to.have.property(\"id\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"El título coincide con el enviado\", function () {\r",
                  "    pm.expect(data.title).to.eql(\"Nuevo post de prueba\");\r",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"title\": \"Nuevo post de prueba\",\r\n    \"body\": \"Contenido del post para pruebas de servicios\",\r\n    \"userId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/posts",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        },
        {
